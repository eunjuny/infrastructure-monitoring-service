{
  "name": "infrastructure-monitoring-web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174 --strictPort",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:auth": "python3 ../scripts/test-auth.py",
    "test:performance:auth": "python3 ../scripts/test-auth.py --performance",
    "test:performance": "node scripts/measure-performance.mjs",
    "test:performance:edges": "node scripts/measure-edge-performance.mjs",
    "test:performance:profile": "node scripts/profile-startup.mjs",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5174 --strictPort"
  },
  "dependencies": {
    "keycloak-js": "26.2.4",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.0",
    "vite": "^7.1.0",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.1.0"
  }
}
