    "preview": "vite preview --host 127.0.0.1 --port 5174 --strictPort"
  },
  "dependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "typescript": "~5.9.0",
    "vite": "^7.1.0",
    "vue-tsc": "^3.1.0",
    "vitest": "^4.1.11",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.1.0",
    "@playwright/test": "^1.55.0"
  }
}
